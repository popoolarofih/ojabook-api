NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ojabook:ojabook@localhost:5432/ojabook
REDIS_URL=redis://localhost:6379
# 48+ random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me-change-me-change-me-change-me
# Comma separated browser origins allowed to call the API with cookies.
WEB_ORIGINS=http://localhost:3000
# console is accepted in development and test only. Production requires a real provider.
OTP_PROVIDER=console
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
